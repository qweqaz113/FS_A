# FuncSim-Agent runtime settings
# Copy this file to .env and fill in local secrets before running LLM-based experiments.

DEEPSEEK_API_KEY=
LLM_MODEL=deepseek:deepseek-v4-flash

# DeepAgents sandbox settings
SANDBOX_CONTAINER_NAME=agent_sandbox
SANDBOX_WORKDIR=/workspace
SANDBOX_SHELL=bash
SANDBOX_EXEC_TIMEOUT=120
SANDBOX_MAX_OUTPUT_BYTES=100000
SANDBOX_SKILLS_DIR=/input/skills
